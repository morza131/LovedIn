http://lovedin.org, http://www.lovedin.org {
    redir https://{host}{uri} permanent
}

https://lovedin.org, https://www.lovedin.org {
    reverse_proxy 127.0.0.1:8080   # ← use service name

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
    }

    encode gzip zstd
}